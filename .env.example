# Aster & Row AI Support Agent Environment Configuration
# Copy this file to .env and configure if connecting to live LLM APIs.
# The system runs 100% locally and deterministically by default without external API keys.

# Optional LLM API Keys (for live model generation)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Agent Configuration
SUPPORT_AGENT_DEBUG=false
KB_DIR=knowledge-base
ORDERS_PATH=data/orders.json
